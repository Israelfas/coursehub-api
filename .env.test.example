# Configuracion exclusiva de las pruebas e2e (npm run test:e2e).
# Copiar como .env.test y completar con valores locales; .env.test no se sube.
# DB_NAME debe terminar en _test: esa base se borra y se recrea en cada corrida.
NODE_ENV=test
DB_HOST=localhost
DB_PORT=5432
DB_NAME=coursehub_test
DB_USER=postgres
DB_PASSWORD=replace-with-your-local-password
JWT_SECRET=replace-with-a-long-random-test-only-secret
JWT_EXPIRES_IN=15m
CORS_ORIGINS=http://localhost:3000
